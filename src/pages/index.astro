  <script>
    const sectorPresets: Record<string, { l1: string; v1: number; l2: string; v2: number; l3: string; v3: number; note: string }> = {
      ecom: {
        l1: 'Google Shopping, Arama & PMax',
        v1: 45,
        l2: 'Instagram, Facebook & Dinamik Katalog (CAPI)',
        v2: 35,
        l3: 'Teknik SEO, Kategori İçeriği & TikTok Kreatif',
        v3: 20,
        note: 'Odak: Sepet Ortalaması (AOV), ROAS ve Sepet Terk Dönüşümü',
      },
      health: {
        l1: 'Uluslararası Google Ads & Yandex Direct (Rusya/BDT/Avrupa)',
        v1: 50,
        l2: 'Meta Lead Gen & WhatsApp Konsültasyon Kampanyaları',
        v2: 35,
        l3: 'Çok Dilli SEO & Yüksek Dönüşümlü Klinik Landing Page',
        v3: 15,
        note: 'Odak: Nitelikli Hasta/Yatırımcı Formu (CPL) ve Uluslararası Erişim',
      },
      b2b: {
        l1: 'Google Yüksek Niyetli Arama Ağı (Ticari Sorgular)',
        v1: 45,
        l2: 'LinkedIn B2B Lead Gen Forms & Şirket (ABM) Hedefleme',
        v2: 35,
        l3: 'Kurumsal SEO, AEO & Dönüşüm Odaklı Web Deneyimi',
        v3: 20,
        note: 'Odak: Doğrulanmış Kurumsal Talep (MQL/SQL) ve Toplantı Randevusu',
      },
    };

    function initSectorSim() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sim-sector]');
      if (!buttons.length) return;

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-sim-sector') || 'ecom';
          const preset = sectorPresets[key];
          if (!preset) return;

          buttons.forEach((b) => {
            const active = b.getAttribute('data-sim-sector') === key;
            b.className = active
              ? 'sim-sector-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-600 text-white cursor-pointer transition'
              : 'sim-sector-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 cursor-pointer transition';
          });

          const l1 = document.getElementById('sim-label-1');
          const v1 = document.getElementById('sim-val-1');
          const b1 = document.getElementById('sim-bar-1');
          const l2 = document.getElementById('sim-label-2');
          const v2 = document.getElementById('sim-val-2');
          const b2 = document.getElementById('sim-bar-2');
          const l3 = document.getElementById('sim-label-3');
          const v3 = document.getElementById('sim-val-3');
          const b3 = document.getElementById('sim-bar-3');
          const note = document.getElementById('sim-kpi-note');

          if (l1) l1.textContent = preset.l1;
          if (v1) v1.textContent = `%${preset.v1} Pay`;
          if (b1) b1.style.width = `${preset.v1}%`;
          if (l2) l2.textContent = preset.l2;
          if (v2) v2.textContent = `%${preset.v2} Pay`;
          if (b2) b2.style.width = `${preset.v2}%`;
          if (l3) l3.textContent = preset.l3;
          if (v3) v3.textContent = `%${preset.v3} Pay`;
          if (b3) b3.style.width = `${preset.v3}%`;
          if (note) note.textContent = preset.note;
        });
      });
    }

    initSectorSim();
    document.addEventListener('astro:after-swap', initSectorSim);
  </script>
