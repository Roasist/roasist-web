        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        if (chTag) chTag.textContent = info.tag;
        if (chLink) chLink.setAttribute('href', info.link);
        if (chDesc) chDesc.textContent = info.desc;
