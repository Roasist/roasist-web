          ['Google Ads & PMax →', '/hizmetler/performans-pazarlamasi/google-reklamlari/'],
          ['Meta CAPI & Katalog →', '/hizmetler/performans-pazarlamasi/facebook-reklamlari/'],
          ['Instagram Reels →', '/hizmetler/performans-pazarlamasi/instagram-reklamlari/'],
          ['E-Ticaret SEO →', '/hizmetler/seo/'],
