        kpi2: 'CRM Entegrasyonu + Çevrimdışı Dönüşüm İçe Aktarımı',
      },
      organic: {
        badge: 'ÖNERİLEN ROASIST MİMARİSİ • ORGANİK & AEO OTORİTESİ',
        title: 'Kalıcı Arama Otoritesi ve Yapay Zeka Görünürlüğü',
        desc: 'Sitenizin teknik altyapısını, Schema.org veri işaretlemelerini ve içerik kümelerini resmi arama hacimlerine göre yapılandırarak reklamsız organik trafiğinizi katlıyoruz.',
        channels: [
          ['Teknik & Kurumsal SEO →', '/hizmetler/seo/'],
          ['Web Tasarım & Core Web Vitals →', '/hizmetler/web-tasarim/'],
          ['360° Dijital Pazarlama →', '/hizmetler/360-derece-dijital-pazarlama-yonetimi/'],
        ],
