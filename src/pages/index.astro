  <script>
    function initPlanTabs() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-plan-tab]');
      const panels = document.querySelectorAll<HTMLElement>('[data-plan-panel]');
      if (!buttons.length) return;

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-plan-tab');
          buttons.forEach((b) => {
            const active = b.getAttribute('data-plan-tab') === target;
            b.className = active
              ? 'plan-tab-btn py-2 px-2.5 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-950 text-slate-900 dark:text-white shadow-2xs'
              : 'plan-tab-btn py-2 px-2.5 rounded-lg text-xs font-semibold transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
          });
          panels.forEach((p) => {
            p.classList.toggle('hidden', p.getAttribute('data-plan-panel') !== target);
          });
        });
      });
    }

    initPlanTabs();
    document.addEventListener('astro:after-swap', initPlanTabs);
  </script>
