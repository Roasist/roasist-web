  }

  .kota-hero-sculpture-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 26px;
    display: block;
  }

  .kota-hero-floating-tag {
    position: absolute;
    background: rgba(13, 13, 16, 0.9);
    backdrop-filter: blur(14px);
    color: #FFFFFF;
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 0.78rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .kota-tag-top {
    top: -14px;
    left: 24px;
  }

  .kota-tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #A855F7;
    box-shadow: 0 0 10px #A855F7;
  }

  .kota-tag-bottom {
    bottom: -16px;
    right: 24px;
    border-radius: 20px;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 12px 18px;
  }

  .kota-tag-bottom strong {
    color: #C084FC;
    font-size: 0.82rem;
  }

  .kota-tag-bottom span {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.75);
  }

  /* KOTA 01 / 02 / 03 Pillars */
  .kota-hero-pillars {
    padding-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }

  .kota-pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .kota-pillar-num {
    font-family: var(--ro-font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--kota-violet);
    white-space: nowrap;
    padding-top: 2px;
  }

  .kota-pillar-title {
    margin: 0 0 6px;
    font-family: var(--ro-font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--kota-ink);
    letter-spacing: -0.02em;
  }

  .kota-pillar-desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--kota-ink-secondary);
  }

  /* =========================================================
     2. KOTA STACKING SERVICE CARDS (GSAP + Sticky Fallback)
     ========================================================= */
  .kota-stack-wrapper {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
  }

  .kota-stack-card {
    position: sticky;
    top: 96px;
    border-radius: 36px;
    padding: 52px;
    border: 1px solid var(--kota-border-strong);
    box-shadow: 0 30px 80px -20px rgba(13, 13, 16, 0.14);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    will-change: transform;
  }

  .kota-stack-card[data-stack-index="0"] {
    top: 92px;
    z-index: 10;
  }

  .kota-stack-card[data-stack-index="1"] {
    top: 116px;
    z-index: 20;
  }

  .kota-stack-card[data-stack-index="2"] {
    top: 140px;
    z-index: 30;
  }

  .kota-stack-theme-light {
    background: #FFFFFF;
    color: var(--kota-ink);
  }

  .kota-stack-theme-dark {
    background: #0D0D10;
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .kota-stack-theme-violet {
    background: linear-gradient(135deg, #2A0066 0%, #7602FF 55%, #4A00B0 100%);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.22);
  }

  .kota-stack-card-inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
  }

  .kota-stack-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 18px;
    opacity: 0.78;
  }

  .kota-stack-divider {
    width: 32px;
    height: 1.5px;
    background: currentColor;
  }

  .kota-stack-title {
    margin: 0 0 16px;
    font-family: var(--ro-font-display);
    font-size: clamp(1.85rem, 3.2vw, 2.85rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .kota-stack-title a {
    color: inherit;
    text-decoration: none;
  }

  .kota-stack-subtitle {
    margin: 0 0 14px;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.5;
    opacity: 0.92;
  }

  .kota-stack-desc {
    margin: 0 0 26px;
    font-size: 0.95rem;
    line-height: 1.65;
    opacity: 0.78;
  }

  .kota-stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 30px;
  }

  .kota-service-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.22s ease;
  }

  .kota-stack-theme-light .kota-service-pill {
    background: var(--kota-bg);
    color: var(--kota-ink);
    border: 1px solid var(--kota-border-strong);
  }

  .kota-stack-theme-light .kota-service-pill:hover {
    background: var(--kota-violet);
    color: #FFFFFF;
    border-color: var(--kota-violet);
    transform: translateY(-2px);
  }

  .kota-stack-theme-dark .kota-service-pill,
  .kota-stack-theme-violet .kota-service-pill {
    background: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .kota-stack-theme-dark .kota-service-pill:hover,
  .kota-stack-theme-violet .kota-service-pill:hover {
    background: #FFFFFF;
    color: #0D0D10;
    transform: translateY(-2px);
  }

  .kota-stack-visual-frame {
    display: block;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
  }

  .kota-stack-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-stack-card:hover .kota-stack-img {
    transform: scale(1.05);
  }

  /* All 11 Services Matrix */
  .kota-all-services-box {
    margin-top: 72px;
    background: #FFFFFF;
    border: 1px solid var(--kota-border-strong);
    border-radius: 36px;
    padding: 48px;
  }

  .kota-all-services-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--kota-border);
  }

  .kota-all-services-head h3 {
    margin: 0;
    font-family: var(--ro-font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .kota-all-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .kota-mini-service-card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    border-radius: 22px;
    background: var(--kota-bg);
    border: 1px solid transparent;
    text-decoration: none;
    color: var(--kota-ink);
    transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-mini-service-card:hover {
    background: #FFFFFF;
    border-color: var(--kota-violet);
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -12px rgba(118, 2, 255, 0.18);
  }

  .kota-mini-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .kota-mini-idx {
    color: var(--kota-violet);
    font-family: var(--ro-font-display);
  }

  .kota-mini-cat {
    color: var(--kota-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .kota-mini-arrow {
    color: var(--kota-violet);
    font-weight: 800;
  }

  .kota-mini-service-card h4 {
    margin: 0 0 8px;
    font-family: var(--ro-font-display);
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .kota-mini-service-card p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--kota-ink-secondary);
  }

  /* =========================================================
     3. KOTA 5-PILL FRAMEWORK SWITCHER
     ========================================================= */
  .kota-framework-section {
    background: #0D0D10;
    color: #FFFFFF;
    border-radius: 44px;
    margin: 0 20px;
  }

  .kota-framework-section .kota-display-h2 {
    color: #FFFFFF;
  }

  .kota-framework-section .kota-display-h2 em {
    color: #C084FC;
  }

  .kota-framework-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 40px;
  }

  .kota-framework-sub {
    margin: 0;
    max-width: 440px;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
  }

  .kota-framework-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }

  .kota-framework-tab {
    padding: 13px 22px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--ro-font-sans);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-framework-tab:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
  }

  .kota-framework-tab.is-active {
    background: var(--kota-violet);
    border-color: var(--kota-violet);
    color: #FFFFFF;
    box-shadow: 0 10px 28px rgba(118, 2, 255, 0.45);
  }

  .kota-framework-panel {
    display: none;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 44px;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 32px;
    padding: 48px;
  }

  .kota-framework-panel.is-active {
    display: grid;
    animation: kotaFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes kotaFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kota-framework-big-num {
    display: inline-block;
    font-family: var(--ro-font-display);
    font-size: 0.9rem;
    font-weight: 800;
    color: #C084FC;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(118, 2, 255, 0.22);
    margin-bottom: 18px;
  }

  .kota-framework-panel-left h3 {
    margin: 0 0 16px;
    font-family: var(--ro-font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 800;
    line-height: 1.15;
    color: #FFFFFF;
  }

  .kota-framework-panel-left p {
    margin: 0 0 24px;
    font-size: 1rem;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.76);
  }

  .kota-framework-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kota-framework-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.94rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .kota-check-icon {
    color: #C084FC;
  }

  .kota-framework-metric-box {
    background: linear-gradient(145deg, rgba(118, 2, 255, 0.32), rgba(21, 21, 27, 0.9));
    border: 1px solid rgba(168, 85, 247, 0.35);
    border-radius: 28px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .kota-framework-metric-val {
    font-family: var(--ro-font-display);
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #FFFFFF;
    margin-bottom: 10px;
  }

  .kota-framework-metric-lbl {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.45;
  }

  /* =========================================================
     4. KOTA "OUR WORK" ASYMMETRIC CASE STUDY GRID
     ========================================================= */
  .kota-work-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 56px;
  }

  .kota-work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 44px;
    align-items: start;
  }

  .kota-work-offset {
    margin-top: 64px;
  }

  .kota-work-card {
    border-radius: 32px;
  }

  .kota-work-link {
    display: block;
    text-decoration: none;
    color: var(--kota-ink);
  }

  .kota-work-image-wrap {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #0D0D10;
    margin-bottom: 22px;
    box-shadow: 0 24px 60px -16px rgba(13, 13, 16, 0.14);
  }

  .kota-work-year {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(13, 13, 16, 0.78);
    backdrop-filter: blur(10px);
    color: #FFFFFF;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .kota-work-impact-pill {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 2;
    padding: 12px 18px;
    border-radius: 18px;
    background: rgba(13, 13, 16, 0.86);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #FFFFFF;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .kota-work-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-work-card:hover .kota-work-img {
    transform: scale(1.06);
  }

  .kota-work-client {
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--kota-violet);
    margin-bottom: 8px;
  }

  .kota-work-title {
    margin: 0 0 14px;
    font-family: var(--ro-font-display);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .kota-work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kota-work-tag {
    padding: 6px 13px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 1px solid var(--kota-border-strong);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--kota-ink-secondary);
  }

  /* =========================================================
     5. KOTA "OUR RESULTS" 4 GIANT METRIC CARDS
     ========================================================= */
  .kota-results-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .kota-result-card {
    background: #FFFFFF;
    border: 1px solid var(--kota-border-strong);
    border-radius: 32px;
    padding: 36px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .kota-result-card:hover {
    background: var(--kota-violet);
    color: #FFFFFF;
    border-color: var(--kota-violet);
    transform: translateY(-8px);
    box-shadow: 0 28px 65px -12px rgba(118, 2, 255, 0.45);
  }

  .kota-result-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .kota-result-index {
    font-family: var(--ro-font-display);
    font-size: 0.85rem;
    font-weight: 800;
    opacity: 0.6;
  }

  .kota-result-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--kota-violet);
    transition: background 0.3s ease;
  }

  .kota-result-card:hover .kota-result-dot {
    background: #FFFFFF;
  }

  .kota-result-value {
    font-family: var(--ro-font-display);
    font-size: clamp(2.8rem, 4.2vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--kota-violet);
    margin-bottom: 18px;
    transition: color 0.3s ease;
  }

  .kota-result-card:hover .kota-result-value {
    color: #FFFFFF;
  }

  .kota-result-label {
    margin: 0 0 10px;
    font-family: var(--ro-font-display);
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .kota-result-detail {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.58;
    opacity: 0.78;
  }

  /* =========================================================
     6. KOTA PARTNERS (TESTIMONIALS + 29 CLIENT LOGOS)
     ========================================================= */
  .kota-testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }

  .kota-testimonial-card {
    margin: 0;
    background: #FFFFFF;
    border: 1px solid var(--kota-border-strong);
    border-radius: 32px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.28s ease, border-color 0.28s ease;
  }

  .kota-testimonial-card:hover {
    transform: translateY(-4px);
    border-color: var(--kota-violet);
  }

  .kota-testimonial-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .kota-quote-mark {
    font-family: var(--ro-font-serif);
    font-size: 3.4rem;
    line-height: 0.8;
    color: var(--kota-violet);
  }

  .kota-testimonial-tag {
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--kota-violet-tint);
    color: var(--kota-violet);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .kota-testimonial-quote {
    margin: 0 0 24px;
    font-size: 0.98rem;
    line-height: 1.68;
    color: var(--kota-ink);
  }

  .kota-testimonial-footer {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 1px solid var(--kota-border);
  }

  .kota-testimonial-footer strong {
    font-size: 0.95rem;
    color: var(--kota-ink);
  }

  .kota-testimonial-footer span {
    font-size: 0.8rem;
    color: var(--kota-ink-muted);
  }

  .kota-logos-showcase {
    background: #FFFFFF;
    border: 1px solid var(--kota-border-strong);
    border-radius: 36px;
    padding: 44px;
  }

  .kota-logos-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 28px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kota-ink-muted);
  }

  .kota-logos-head a {
    color: var(--kota-violet);
    text-decoration: none;
  }

  .kota-logos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(135px, 1fr));
    gap: 14px;
  }

  .kota-logo-cell {
    height: 76px;
    border-radius: 18px;
    background: var(--kota-bg);
    border: 1px solid rgba(13, 13, 16, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    transition: all 0.22s ease;
  }

  .kota-logo-cell:hover {
    background: #FFFFFF;
    border-color: var(--kota-violet);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(118, 2, 255, 0.1);
  }

  .kota-logo-cell img {
    max-width: 100%;
    max-height: 44px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(100%) contrast(1.1);
    opacity: 0.78;
    transition: filter 0.22s ease, opacity 0.22s ease;
  }

  .kota-logo-cell:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* =========================================================
     7. KOTA BLOG & FAQ ACCORDION
     ========================================================= */
  .kota-blog-block {
    margin-bottom: 96px;
