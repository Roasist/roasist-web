        outputs: [
          ['Hesap & Bütçe Denetimi', 'Boşa harcanan tıklamaların ve negatif kelime eksikliklerinin tespiti'],
          ['Teknik SEO & Hız Kontrolü', 'Core Web Vitals, tarama bütçesi ve mobil dönüşüm engelleri analizi'],
          ['90 Günlük Büyüme Planı', 'Kanal bazlı hedef CPA/ROAS projeksiyonu ve yol haritası'],
        ],
      },
      {
        phase: 'ADIM 02 • 2. HAFTA',
        badge: 'Kusursuz Veri & Sinyal Mimarisi',
        title: 'Sunucu Taraflı (Server-Side) Ölçümleme ve Dönüşüm Kurulumu',
        desc: 'Reklam algoritmalarının doğru müşteriyi bulabilmesi için doğru veriyle beslenmesi şarttır. Kampanyaları başlatmadan önce tüm dönüşüm sinyallerini kayıpsız çalışacak şekilde kuruyoruz.',
        outputs: [
          ['GA4 & GTM Server-Side', 'Tarayıcı kısıtlamalarından etkilenmeyen birinci taraf veri takibi'],
          ['Meta CAPI & Gelişmiş Dönüşümler', 'Satış ve form verilerinin reklam platformlarına şifreli aktarımı'],
          ['Ürün Feed & Katalog Mimarisi', 'Google Merchant Center ve Meta kataloglarının hatasız yapılandırılması'],
