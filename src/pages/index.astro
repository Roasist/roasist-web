        kpi2: 'Search Console + Resmi Google Arama Hacmi Analizi',
      },
      rebrand: {
        badge: 'ÖNERİLEN ROASIST MİMARİSİ • 360° DİJİTAL DÖNÜŞÜM',
        title: 'Modern Web Altyapısı ve Çok Kanallı Büyüme Lansmanı',
        desc: 'Eski web sitenizi sıfır SEO kaybıyla modern, hızlı bir dönüşüm platformuna taşıyor; tüm reklam ve kreatif süreçlerinizi tek merkezden yönetiyoruz.',
        channels: [
          ['360° Dijital Pazarlama →', '/hizmetler/360-derece-dijital-pazarlama-yonetimi/'],
          ['Web Tasarım & Dönüşüm →', '/hizmetler/web-tasarim/'],
          ['Grafik & Reklam Kreatifi →', '/hizmetler/grafik-tasarim/'],
