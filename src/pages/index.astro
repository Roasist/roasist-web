---
import PageLayout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import clientsData from '~/data/clients.json';

const metadata = {
  title: 'Roasist - Özelleştirilmiş Dijital Pazarlama ve Büyüme Ajansı',
  ignoreTitleTemplate: true,
  description:
    'Roasist; Google Ads, Meta reklamları, kurumsal SEO/AEO, 360° dijital pazarlama ve dönüşüm odaklı web tasarım hizmetleriyle markaların reklam bütçesini ölçülebilir ciroya dönüştürür.',
  robots: {
    index: true,
    follow: true,
  },
};

const servicesList = [
  {
    slug: 'performans-pazarlamasi',
    permalink: '/hizmetler/performans-pazarlamasi/',
    category: 'performans',
    categoryLabel: 'Performans المimarisi',
    badge: 'Ana Disiplin',
    title: 'Performans Pazarlaması Yönetimi',
    summary:
      'Tüm ücretli medya kanallarınızı tıklama maliyetine değil, gerçek müşteri edinme maliyetine (CPA) ve reklam harcaması geri dönüşüne (ROAS) göre yönetiyoruz.',
    deliverables: [
      'Çok kanallı bütçe ve ROAS optimizasyonu',
      'Server-Side GTM, GA4 ve dönüşüm API kurulumu',
      '7/24 canlı Looker Studio performans raporlaması',
    ],
  },
  {
    slug: 'performans-pazarlamasi/google-reklamlari',
    permalink: '/hizmetler/performans-pazarlamasi/google-reklamlari/',
    category: 'performans',
    categoryLabel: 'Arama & Alışveriş',
    badge: 'Performans Kanalı',
    title: 'Google Reklamları (Google Ads)',
    summary:
      'Satın alma niyeti en yüksek kullanıcıları Arama Ağı, Performance Max, Google Shopping ve YouTube kampanyalarıyla tam karar anında yakalayın.',
    deliverables: [
      'Resmi Google arama hacmi verileriyle kelime mimarisi',
      'Merchant Center ve PMax ürün feed optimizasyonu',
      'Negatif kelime temizliği ve akıllı teklif yönetimi',
    ],
  },
  {
    slug: 'performans-pazarlamasi/facebook-reklamlari',
    permalink: '/hizmetler/performans-pazarlamasi/facebook-reklamlari/',
    category: 'performans',
    categoryLabel: 'Sosyal Ticaret',
    badge: 'Performans Kanalı',
    title: 'Facebook Reklamları (Meta Ads)',
    summary:
      'Gelişmiş Conversions API (CAPI) sinyal mimarisi, dinamik ürün katalogları ve çok katmanlı yeniden pazarlama kurgularıyla ölçeklenebilir satış üretin.',
    deliverables: [
      'Meta Pixel + Sunucu Taraflı CAPI entegrasyonu',
      'Advantage+ alışveriş ve dinamik katalog kurguları',
      'Kreatif A/B testleri ve kitle segmentasyonu',
    ],
  },
  {
    slug: 'performans-pazarlamasi/instagram-reklamlari',
    permalink: '/hizmetler/performans-pazarlamasi/instagram-reklamlari/',
    category: 'performans',
    categoryLabel: 'Görsel Dönüşüm',
    badge: 'Performans Kanalı',
    title: 'Instagram Reklamları',
    summary:
      'Reels, Hikayeler ve Keşfet yerleşimlerinde dikkat süresini satışa çeviren yüksek dönüşümlü görsel ve video reklam hunileri kurguluyoruz.',
    deliverables: [
      'Reels ve Story odaklı dikey kreatif stratejisi',
      'Etkileşimden sepete tam huni (Full-Funnel) kurgusu',
      'Yüksek satın alma eğilimli benzer (Lookalike) kitleler',
    ],
  },
  {
    slug: 'performans-pazarlamasi/tiktok-reklamlari',
    permalink: '/hizmetler/performans-pazarlamasi/tiktok-reklamlari/',
    category: 'performans',
    categoryLabel: 'Yeni Nesil Video',
    badge: 'Performans Kanalı',
    title: 'TikTok Reklamları',
    summary:
      'Platformun doğal akışına uyumlu Spark Ads, UGC içerik kurguları ve katalog reklamlarıyla genç ve dinamik kitleleri düşük maliyetle müşteriye dönüştürün.',
    deliverables: [
      'Spark Ads ve içerik üretici odaklı reklam kurgusu',
      'TikTok Pixel ve Events API sinyal optimizasyonu',
      'Düşük BGBM ile yüksek erişim ve dönüşüm ölçekleme',
    ],
  },
  {
    slug: 'performans-pazarlamasi/linkedin-reklamlari',
    permalink: '/hizmetler/performans-pazarlamasi/linkedin-reklamlari/',
    category: 'performans',
    categoryLabel: 'B2B & Kurumsal',
    badge: 'Performans Kanalı',
    title: 'LinkedIn B2B Reklamları',
    summary:
      'Şirket büyüklüğü, sektör, unvan ve karar verici kıdemine göre nokta atışı hedefleme yaparak kurumsal satış ekibinize nitelikli B2B talepler (Lead) kazandırın.',
    deliverables: [
      'C-Level ve satın alma yöneticisi unvan hedeflemesi',
      'LinkedIn Lead Gen Forms ve CRM entegrasyonu',
      'Account-Based Marketing (ABM) şirket listesi reklamları',
    ],
  },
  {
    slug: 'performans-pazarlamasi/yandex-reklamlari',
    permalink: '/hizmetler/performans-pazarlamasi/yandex-reklamlari/',
    category: 'performans',
    categoryLabel: 'Uluslararası Pazar',
    badge: 'Performans Kanalı',
    title: 'Yandex Reklamları (Yandex Direct)',
    summary:
      'Rusya, BDT ülkeleri ve uluslararası pazarlarda hedef kitlenize Yandex Arama Ağı, РСЯ (Reklam Ağı) ve Metrica analitiği ile doğrudan ulaşın.',
    deliverables: [
      'Rusça ve uluslararası anahtar kelime stratejisi',
      'Yandex Metrica ve Webmaster dönüşüm takibi',
      'İhracat ve sağlık turizmi odaklı kampanya yönetimi',
    ],
  },
  {
    slug: 'seo',
    permalink: '/hizmetler/seo/',
    category: 'seo',
    categoryLabel: 'Organik & Yapay Zeka',
    badge: 'Ana Disiplin',
    title: 'SEO & Yapay Zeka Aramaları (AEO)',
    summary:
      'Sitenizi yalnızca klasik Google aramaları için değil; ChatGPT, Perplexity ve Google AI Overviews gibi yanıt motorları (AEO) için de otorite kaynağına dönüştürüyoruz.',
    deliverables: [
      'Teknik SEO, Core Web Vitals ve Schema.org mimarisi',
      'Resmi arama hacmi verileriyle semantik içerik kümeleme',
      'Yapay zeka arama motorları (AEO) için doğrudan yanıt optimizasyonu',
    ],
  },
  {
    slug: '360-derece-dijital-pazarlama-yonetimi',
    permalink: '/hizmetler/360-derece-dijital-pazarlama-yonetimi/',
    category: 'strateji',
    categoryLabel: 'Bütünsel Yönetim',
    badge: 'Ana Disiplin',
    title: '360° Dijital Pazarlama Yönetimi',
    summary:
      'Ücretli reklam, organik SEO, içerik, kreatif üretim ve dönüşüm optimizasyonunu birbirinden kopuk ajanslar yerine tek bir stratejik merkezden yönetin.',
    deliverables: [
      'Kanallar arası bütçe ve atribüsyon sinerjisi',
      'Tek muhatap ile uçtan uca büyüme sorumluluğu',
      'Aylık yönetim kurulu düzeyinde büyüme ve kârlılık analizi',
    ],
  },
  {
    slug: 'web-tasarim',
    permalink: '/hizmetler/web-tasarim/',
    category: 'strateji',
    categoryLabel: 'Web & Dönüşüm',
    badge: 'Ana Disiplin',
    title: 'Web Tasarım & Dönüşüm Mimarisi',
    summary:
      'Reklam trafiğinizi müşteriye dönüştüren; ultra hızlı açılan, mobil öncelikli, teknik SEO altyapısı eksiksiz modern kurumsal web siteleri inşa ediyoruz.',
    deliverables: [
      'Core Web Vitals (LCP, INP, CLS) hız optimizasyonu',
      'Dönüşüm oranı optimizasyonu (CRO) odaklı kullanıcı deneyimi',
      'SEO ve yapay zeka tarayıcılarıyla %100 uyumlu semantik kodlama',
    ],
  },
  {
    slug: 'grafik-tasarim',
    permalink: '/hizmetler/grafik-tasarim/',
    category: 'strateji',
    categoryLabel: 'Kreatif & Marka',
    badge: 'Ana Disiplin',
    title: 'Grafik Tasarım & Performans Kreatifi',
    summary:
      'Reklam algoritmalarında tıklama oranını (CTR) artıran ve markanızın kurumsal algısını yükselten veri destekli reklam kreatifleri ve görsel sistemler tasarlıyoruz.',
    deliverables: [
      'Meta, TikTok ve Google için dönüşüm odaklı reklam setleri',
      'Kurumsal kimlik, sunum ve dijital marka kılavuzu',
      'Kreatif yorgunluğu önleyen düzenli varyasyon üretimi',
    ],
  },
];

const faqs = [
  {
    question: 'Roasist klasik bir dijital reklam ajansından nasıl ayrılır?',
    answer:
      'Klasik ajanslar genellikle gösterim ve tıklama gibi yüzeysel metrikleri raporlarken, Roasist doğrudan reklam harcaması geri dönüşüne (ROAS), müşteri edinme maliyetine (CPA) ve gerçek ciroya odaklanır. Sunucu taraflı dönüşüm takibi (Server-Side GTM, Meta CAPI), resmi Google arama hacmi verileri ve 7/24 açık canlı raporlama panelleriyle tüm süreci şeffaf yürütürüz.',
  },
  {
    question: 'Hangi sektörler ve bütçe ölçekleriyle çalışıyorsunuz?',
    answer:
      'E-ticaret, B2B teknoloji ve sanayi, sağlık ve medikal turizm, eğitim, gayrimenkul ve kurumsal hizmet sektörlerinde büyüme hedefi olan markalarla çalışıyoruz. Bütçenizin büyüklüğünden bağımsız olarak, her kuruşun ölçülebilir bir geri dönüş üretmesi için ölçeklenebilir kanal stratejileri kurguluyoruz.',
  },
  {
    question: 'Reklam hesaplarının ve verilerin mülkiyeti kimde kalır?',
    answer:
      'Google Ads, Meta Business Manager, Google Analytics 4, Tag Manager ve Search Console dahil tüm hesapların %100 mülkiyeti her zaman sizin şirketinizde kalır. Roasist şeffaflık ilkesi gereği hiçbir hesabı kapalı kutu olarak yönetmez.',
  },
  {
    question: 'Mevcut web sitemizi veya SEO yapımızı bozmadan geçiş yapabilir miyiz?',
    answer:
      'Evet. Hem SEO hem de web yenileme projelerinde URL mimarinizi, geçmiş organik otoritenizi, canonical yapınızı ve arama motoru sıralamalarınızı sıfır kayıp (Zero SEO Loss) protokolüyle koruyarak geçiş sağlıyoruz.',
  },
  {
    question: 'Ücretsiz büyüme analizi sürecinde neler sunuyorsunuz?',
    answer:
      'İlk görüşme öncesinde mevcut reklam hesaplarınızı, web sitenizin teknik hız/SEO durumunu ve sektörünüzdeki gerçek arama hacimlerini inceliyoruz. Görüşmede bütçe kaçağı yaratan noktaları ve ilk 90 günde uygulanabilecek somut büyüme yol haritasını paylaşıyoruz.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'MarketingAgency',
    '@id': 'https://www.roasist.com/#organization',
    name: 'Roasist',
    url: 'https://www.roasist.com/',
    email: 'info@roasist.com',
    description: metadata.description,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'İstanbul',
      addressCountry: 'TR',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Roasist Dijital Pazarlama Hizmetleri',
    itemListElement: servicesList.map((s, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: s.title,
      url: `https://www.roasist.com${s.permalink}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<PageLayout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. SUNLIT HERO SECTION -->
  <section class="ro-hero-section">
    <div class="ro-container">
      <div class="ro-hero-grid">
        <!-- Left Column: Crisp Editorial Copy -->
        <div class="ro-hero-copy">
          <span class="ro-kicker">VERİ ODAKLI DİJİTAL BÜYÜME & PERFORMANS AJANSI</span>
          <h1 class="ro-hero-title">
            Reklam bütçenizi tahmine değil, <em class="ro-serif-italic">ölçülebilir</em> büyümeye dönüştürün.
          </h1>
          <p class="ro-hero-lead">
            Roasist; Google Ads, Meta, TikTok ve LinkedIn performans reklamlarını, kurumsal SEO/AEO mimarisini ve yüksek dönüşümlü web tasarımını tek bir şeffaf çatı altında birleştirir.
          </p>

          <div class="ro-hero-actions">
            <a href="/iletisim/" class="ro-btn ro-btn-primary ro-btn-lg" id="hero-cta-primary">
              Ücretsiz Büyüme Analizi Alın
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            <a href="#hizmetler" class="ro-btn ro-btn-secondary ro-btn-lg" id="hero-cta-secondary">
              11 Uzmanlık Alanını İnceleyin
            </a>
          </div>

          <div class="ro-hero-metrics" aria-label="Kurumsal Göstergeler">
            <div class="ro-metric-item">
              <strong>11 Uzmanlık</strong>
              <span>Performans, SEO/AEO & Web</span>
            </div>
            <div class="ro-metric-item">
              <strong>29+ Marka</strong>
              <span>Kurumsal & E-Ticaret Referansı</span>
            </div>
            <div class="ro-metric-item">
              <strong>%100 Şeffaf</strong>
              <span>7/24 Canlı Veri & Hesap Mülkiyeti</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Sunlit Studio Visual + Interactive Channel Preview -->
        <div class="ro-hero-visual-col">
          <div class="ro-hero-frame">
            <img
              src="/images/sunlit-hero.webp"
              alt="Roasist veri berraklığı ve büyüme mimarisini temsil eden optik prizma ve kobalt halkalar"
              width="900"
              height="675"
              class="ro-hero-img"
              loading="eager"
            />

            <!-- Interactive Floating Channel Switcher Card -->
            <div class="ro-hero-interactive-card" aria-label="Büyüme Kanalı Önizleyici">
              <div class="ro-channel-tabs" role="tablist">
                <button type="button" class="ro-ch-tab is-active" data-ch="google" role="tab" aria-selected="true">Google Ads</button>
                <button type="button" class="ro-ch-tab" data-ch="meta" role="tab" aria-selected="false">Meta & TikTok</button>
                <button type="button" class="ro-ch-tab" data-ch="seo" role="tab" aria-selected="false">SEO & AEO</button>
                <button type="button" class="ro-ch-tab" data-ch="full" role="tab" aria-selected="false">360° Büyüme</button>
              </div>
              <div class="ro-channel-body" id="ro-channel-panel">
                <div class="ro-ch-header">
                  <span class="ro-ch-tag" id="ro-ch-tag">Yüksek Satın Alma Niyeti</span>
                  <a href="/hizmetler/performans-pazarlamasi/google-reklamlari/" class="ro-ch-link" id="ro-ch-link">Detay →</a>
                </div>
                <p class="ro-ch-desc" id="ro-ch-desc">
                  Resmi arama hacmi verileri, negatif kelime izolasyonu ve PMax feed optimizasyonu ile doğrudan satışa dönüşen talebi yakalıyoruz.
                </p>
                <div class="ro-ch-pills" id="ro-ch-pills">
                  <span>Arama Ağı & PMax</span>
                  <span>Server-Side Dönüşüm</span>
                  <span>ROAS Odaklı Teklif</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 29 REAL CLIENT LOGOS SHOWCASE (CLEAN, AIRY, SUNLIT) -->
  <section class="ro-clients-section" aria-labelledby="clients-heading">
    <div class="ro-container">
      <div class="ro-clients-header">
        <div>
          <span class="ro-kicker">KURUMSAL GÜVEN & İŞ ORTAKLIKLARI</span>
          <h2 id="clients-heading" class="ro-section-title-sm">
            Farklı sektörlerden <strong>29+ marka</strong> dijital büyümesini Roasist ile yönetiyor.
          </h2>
        </div>
        <div class="ro-clients-actions">
          <button type="button" class="ro-btn ro-btn-secondary ro-btn-sm" id="toggle-all-logos">
            Tüm 29 Logoyu Tabloda Gör
          </button>
          <a href="/referanslar/" class="ro-text-link">Referanslar Sayfası →</a>
        </div>
      </div>

      <!-- Smooth Airy Marquee on White Cards -->
      <div class="ro-marquee-wrap" id="ro-logo-marquee">
        <div class="ro-marquee-track">
          {[...clientsData, ...clientsData].map((client, idx) => (
            <div class="ro-logo-pill" aria-hidden={idx >= clientsData.length ? 'true' : undefined}>
              <img src={client.logo} alt={client.name} loading="lazy" width="130" height="52" />
            </div>
          ))}
        </div>
      </div>

      <!-- Expandable Full 29-Logo Clean Grid -->
      <div class="ro-logos-full-grid" id="ro-logos-full-grid" hidden>
        {clientsData.map((client) => (
          <div class="ro-logo-grid-card">
            <img src={client.logo} alt={client.name} loading="lazy" width="130" height="52" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. ALL 11 SERVICES ARCHITECTURE (FILTERABLE, SPACIOUS WHITE CARDS) -->
  <section class="ro-services-section" id="hizmetler" aria-labelledby="services-heading">
    <div class="ro-container">
      <div class="ro-section-head">
        <div>
          <span class="ro-kicker">BÜTÜNSEL HİZMET MİMARİSİ</span>
          <h2 id="services-heading" class="ro-section-title">
            Markanızın ihtiyaç duyduğu tüm büyüme disiplinleri, <em class="ro-serif-italic">tek</em> çatı altında.
          </h2>
        </div>
        <p class="ro-section-subtitle">
          Birbirinden kopuk ajanslar ve dağınık raporlar yerine; ücretli medya, organik arama otoritesi ve dönüşüm tasarımını birbirini besleyen tek bir sistem olarak kurguluyoruz.
        </p>
      </div>

      <!-- Interactive Category Filter Tabs -->
      <div class="ro-filter-bar" role="tablist" aria-label="Hizmet Kategorileri">
        <button type="button" class="ro-filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
          Tüm Hizmetler <span class="ro-count">11</span>
        </button>
        <button type="button" class="ro-filter-btn" data-filter="performans" role="tab" aria-selected="false">
          Performans Pazarlaması <span class="ro-count">7</span>
        </button>
        <button type="button" class="ro-filter-btn" data-filter="seo" role="tab" aria-selected="false">
          SEO & Yapay Zeka (AEO) <span class="ro-count">1</span>
        </button>
        <button type="button" class="ro-filter-btn" data-filter="strateji" role="tab" aria-selected="false">
          360° Yönetim, Web & Kreatif <span class="ro-count">3</span>
        </button>
      </div>

      <!-- Spacious 3-Column Service Cards Grid -->
      <div class="ro-services-grid" id="ro-services-grid">
        {servicesList.map((service) => (
          <article class="ro-service-card" data-category={service.category}>
            <div class="ro-service-card-top">
              <span class="ro-service-cat">{service.categoryLabel}</span>
              <span class="ro-service-badge">{service.badge}</span>
            </div>
            <h3 class="ro-service-title">
              <a href={service.permalink}>{service.title}</a>
            </h3>
            <p class="ro-service-summary">{service.summary}</p>
            <ul class="ro-service-list">
              {service.deliverables.map((item) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="ro-service-footer">
              <a href={service.permalink} class="ro-service-link">
                <span>Hizmet Mimarisini İncele</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. SUNLIT STUDIO & WHY ROASIST (EDITORIAL CLARITY) -->
  <section class="ro-editorial-section" aria-labelledby="editorial-heading">
    <div class="ro-container">
      <div class="ro-editorial-grid">
        <div class="ro-editorial-media">
          <div class="ro-studio-photo-card">
            <img
              src="/images/sunlit-studio.webp"
              alt="Roasist yalın ve şeffaf çalışma kültürünü yansıtan aydınlık strateji stüdyosu"
              width="900"
              height="506"
              loading="lazy"
            />
            <div class="ro-studio-caption">
              <strong>Şeffaf Veri & Ortak Akıl Kültürü</strong>
              <span>Karmaşık terimler değil, yönetim kurulunuzda karşılığı olan net ticari sonuçlar üretiyoruz.</span>
            </div>
          </div>
        </div>

        <div class="ro-editorial-content">
          <span class="ro-kicker">NEDEN ROASIST?</span>
          <h2 id="editorial-heading" class="ro-section-title">
            Gürültüyü eliyor, bütçenizi yalnızca <em class="ro-serif-italic">sonuç</em> üreten kanallara odaklıyoruz.
          </h2>
          <p class="ro-editorial-lead">
            Dijital pazarlamada en büyük bütçe kaybı, yanlış kurulmuş dönüşüm sinyalleri ve tahmine dayalı medya planlamasından kaynaklanır. Roasist, her kampanyayı mühendislik hassasiyetiyle kurar.
          </p>

          <div class="ro-pillars-list">
            <div class="ro-pillar-row">
              <div class="ro-pillar-num">01</div>
              <div>
