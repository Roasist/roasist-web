<!-- KOTA Interactive Engine: Fluid #7602FF Canvas + Kinetic Headings + Framework Switcher + Stacking Scale -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. KOTA Interactive #7602FF Fluid Gradient Canvas in Hero
    const canvas = document.getElementById('kota-fluid-canvas');
    if (canvas && canvas.getContext) {
      const ctx = canvas.getContext('2d');
      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);
      let mouseX = width * 0.65;
      let mouseY = height * 0.4;
      let targetX = mouseX;
      let targetY = mouseY;
      let tick = 0;

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }, { passive: true });

      window.addEventListener('mousemove', (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
      }, { passive: true });

      function renderFluid() {
        tick += 0.012;
        mouseX += (targetX - mouseX) * 0.06;
        mouseY += (targetY - mouseY) * 0.06;

        ctx.clearRect(0, 0, width, height);

        // Orb 1: Primary Brand #7602FF
        const x1 = mouseX + Math.cos(tick) * 90;
        const y1 = mouseY + Math.sin(tick * 1.2) * 70;
        const g1 = ctx.createRadialGradient(x1, y1, 20, x1, y1, Math.max(width, height) * 0.42);
        g1.addColorStop(0, 'rgba(118, 2, 255, 0.24)');
        g1.addColorStop(0.5, 'rgba(168, 85, 247, 0.10)');
        g1.addColorStop(1, 'rgba(244, 243, 239, 0)');

        // Orb 2: Secondary Magenta/Violet Drift
        const x2 = width * 0.25 + Math.sin(tick * 0.8) * 140;
        const y2 = height * 0.35 + Math.cos(tick * 0.9) * 90;
        const g2 = ctx.createRadialGradient(x2, y2, 10, x2, y2, Math.max(width, height) * 0.36);
        g2.addColorStop(0, 'rgba(200, 0, 255, 0.15)');
        g2.addColorStop(1, 'rgba(244, 243, 239, 0)');

        ctx.fillStyle = g1;
        ctx.fillRect(0, 0, width, height);
        ctx.fillStyle = g2;
        ctx.fillRect(0, 0, width, height);

        requestAnimationFrame(renderFluid);
      }
      renderFluid();
    }

    // 2. KOTA Kinetic Letter-by-Letter Headings (H i z m e t l e r i m i z, etc.)
    document.querySelectorAll('[data-kinetic]').forEach((heading) => {
      const text = heading.getAttribute('data-kinetic') || heading.textContent || '';
      heading.innerHTML = text
        .split('')
        .map((ch) => (ch === ' ' ? '&nbsp;' : `<span class="kota-char">${ch}</span>`))
        .join('');
    });

    // 3. KOTA 5-Pill Framework Switcher
    const tabs = document.querySelectorAll('.kota-framework-tab');
    const panels = document.querySelectorAll('.kota-framework-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-framework-target');
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => p.classList.remove('is-active'));

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.add('is-active');
      });
    });

    // 4. KOTA Stacking Service Cards Zoom-Out Effect on Scroll
    const stackCards = Array.from(document.querySelectorAll('.kota-stack-card'));
    if (stackCards.length > 1 && window.innerWidth > 1080) {
      window.addEventListener('scroll', () => {
        stackCards.forEach((card, idx) => {
          const nextCard = stackCards[idx + 1];
          if (!nextCard) return;
          const rect = card.getBoundingClientRect();
          const nextRect = nextCard.getBoundingClientRect();
          const overlap = Math.max(0, Math.min(1, (rect.bottom - nextRect.top) / rect.height));
          if (nextRect.top < window.innerHeight && nextRect.top > 80) {
            const scale = 1 - overlap * 0.055;
            card.style.transform = `scale(${scale.toFixed(3)})`;
          } else if (nextRect.top >= window.innerHeight) {
            card.style.transform = 'scale(1)';
          }
        });
      }, { passive: true });
    }
  });
</script>