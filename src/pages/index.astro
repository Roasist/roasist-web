        title: 'Kârlı Kanalları Ölçekleme ve 7/24 Şeffaf Performans Takibi',
        desc: 'Yayındaki kampanyaları günlük olarak optimize ediyor, düşük performanslı kırılımları durdurup yüksek ROAS üreten kitle ve kelimelere bütçe aktarıyoruz.',
        outputs: [
          ['7/24 Canlı Looker Studio Paneli', 'Harcanan bütçe, ciro, ROAS ve CPA metriklerinin anlık takibi'],
          ['Kreatif & Teklif Rotasyonu', 'Reklam yorgunluğunu önleyen proaktif optimizasyon döngüsü'],
          ['Stratejik Büyüme Toplantıları', 'Yeni pazar, kanal ve kategori fırsatlarının düzenli değerlendirilmesi'],
        ],
      },
    ];

    const stepTabs = document.querySelectorAll('.ro-step-tab');
    const procPhase = document.getElementById('proc-phase');
    const procBadge = document.getElementById('proc-badge');
    const procTitle = document.getElementById('proc-title');
    const procDesc = document.getElementById('proc-desc');
    const procOutputs = document.getElementById('proc-outputs');

    stepTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = Number(tab.getAttribute('data-step'));
        const data = processSteps[idx];
        if (!data) return;
        stepTabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        if (procPhase) procPhase.textContent = data.phase;
        if (procBadge) procBadge.textContent = data.badge;
        if (procTitle) procTitle.textContent = data.title;
        if (procDesc) procDesc.textContent = data.desc;
        if (procOutputs) {
          procOutputs.innerHTML = data.outputs
            .map(
              ([head, sub]) =>
                `<div class="ro-output-box"><strong>${head}</strong><span>${sub}</span></div>`
            )
            .join('');
        }
      });
    });

    // 5. Interactive Goal Planner
    const goalPlans = {
      ecommerce: {
        badge: 'ÖNERİLEN ROASIST MİMARİSİ • E-TİCARET',
