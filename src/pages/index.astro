---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import { SITE, I18N } from 'astrowind:config';
import clients from '~/data/clients.json';
import { defaultProcessSteps, defaultWhyUs } from '~/data/services';

const metadata = {
  title: 'Roasist - Özelleştirilmiş Dijital Pazarlama Hizmetleri',
  ignoreTitleTemplate: true,
  description:
    'Roasist, özelleştirilmiş dijital pazarlama hizmetleri ve yenilikçi yaklaşımıyla öne çıkan bir dijital pazarlama ajansıdır.',
};

const siteUrl = SITE?.site || 'https://www.roasist.com';
const organizationId = `${siteUrl}/#organization`;

const homeFaqs = [
  {
    question: 'Roasist hangi dijital pazarlama hizmetlerini sunuyor?',
    answer:
      'Roasist; 360° Dijital Pazarlama Yönetimi, Performans Pazarlaması (Google Ads, Instagram, Facebook, TikTok, LinkedIn ve Yandex Reklamları), Arama Motoru Optimizasyonu (SEO), Dönüşüm Odaklı Web Tasarım ve Kreatif Grafik Tasarım hizmetlerini veri odaklı bir yaklaşımla sunar.',
  },
  {
    question: 'Çalışma süreciniz nasıl başlıyor?',
    answer:
      'Sürecimiz ücretsiz ön analiz ve strateji görüşmesiyle başlar. Mevcut dijital varlıklarınızı, reklam hesaplarınızı ve sektörünüzdeki gerçek arama hacimlerini inceler; işletmenize özel KPI ve büyüme yol haritasını çıkarırız.',
  },
  {
    question: 'Reklam hesapları ve veriler kimin mülkiyetinde oluyor?',
    answer:
      'Şeffaflık ilkemiz gereği tüm reklam hesapları (Google Ads, Meta, TikTok, LinkedIn, Yandex) ve analitik mülkleri doğrudan sizin adınıza açılır ve %100 sizin mülkiyetinizde kalır. Tüm performans verilerini 7/24 canlı olarak takip edebilirsiniz.',
  },
  {
    question: 'Sadece tek bir hizmet (örneğin SEO veya Google Ads) alabilir miyiz?',
    answer:
      'Evet. İhtiyacınıza göre yalnızca Google Reklamları, SEO veya Web Tasarım gibi tekil uzmanlık hizmetlerimizden faydalanabileceğiniz gibi, tüm dijital kanallarınızı kapsayan 360° Dijital Pazarlama Yönetimi modelimizle de çalışabilirsiniz.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'Roasist',
    url: siteUrl,
    inLanguage: I18N?.language || 'tr',
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MarketingAgency',
    '@id': organizationId,
    name: 'Roasist',
    url: siteUrl,
    logo: `${siteUrl}/roasist-logo.svg`,
    description:
      'Roasist, özelleştirilmiş dijital pazarlama hizmetleri, performans pazarlaması, SEO, web tasarım ve veri analitiği çözümleri sunan yeni nesil büyüme ajansıdır.',
    telephone: '+905415075350',
    sameAs: [
      'https://www.linkedin.com/company/roasist/',
      'https://www.instagram.com/roasist/',
      'https://twitter.com/Roasistt',
      'https://www.facebook.com/roasistt',
      'https://www.youtube.com/channel/UCY3G_IU2YJ326zGwU3_YlyA',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];

const adChannels = [
  {
    name: 'Google Reklamları',
    metric: 'Arama · PMax · Shopping · YouTube',
    desc: 'Satın alma niyeti en yüksek aramalarda en üst sırada yer alarak doğrudan satış ve talep toplayın.',
    href: '/hizmetler/performans-pazarlamasi/google-reklamlari/',
    icon: 'tabler:brand-google',
  },
  {
    name: 'Instagram Reklamları',
    metric: 'Reels · Story · Dinamik Katalog',
    desc: '52M+ aktif kullanıcıya yüksek etkileşimli dikey videolar ve CAPI destekli dönüşüm kurgularıyla ulaşın.',
    href: '/hizmetler/performans-pazarlamasi/instagram-reklamlari/',
    icon: 'tabler:brand-instagram',
  },
  {
    name: 'Facebook Reklamları',
    metric: 'Advantage+ · CAPI · Retargeting',
    desc: 'Meta makine öğrenimi ve gelişmiş yeniden pazarlama katmanlarıyla sepet terkleri satışa dönüştürün.',
    href: '/hizmetler/performans-pazarlamasi/facebook-reklamlari/',
    icon: 'tabler:brand-facebook',
  },
  {
    name: 'TikTok Reklamları',
    metric: 'Spark Ads · In-Feed · Events API',
    desc: 'İlk 3 saniyede yakalayan kreatif kurgularla viral erişim ve düşük maliyetli e-ticaret dönüşümü yakalayın.',
    href: '/hizmetler/performans-pazarlamasi/tiktok-reklamlari/',
    icon: 'tabler:brand-tiktok',
  },
  {
    name: 'LinkedIn Reklamları',
    metric: 'B2B Lead Gen · ABM · Karar Vericiler',
    desc: 'Şirket büyüklüğü, sektör ve C-Level unvan hedeflemesiyle kurumsal B2B satış fırsatları yaratın.',
    href: '/hizmetler/performans-pazarlamasi/linkedin-reklamlari/',
    icon: 'tabler:brand-linkedin',
  },
  {
    name: 'Yandex Reklamları',
    metric: 'Rusya & BDT · Direct & YAN · Metrica',
    desc: 'Sağlık turizmi, gayrimenkul ve ihracat için Rusça konuşulan pazarların #1 arama motorunda lider olun.',
    href: '/hizmetler/performans-pazarlamasi/yandex-reklamlari/',
    icon: 'tabler:world',
  },
];

const testimonials = [
  {
    quote:
      'Reklam sürecinde projeye yaklaşımları, anlaşmamızın ötesinde sorumluluk alarak aynı zamanda bir grafik tasarımcı katkısı sunmaları, mesai kavramından uzak 7/24 destek ve hassasiyet ile bizim işimiz için en az bizim kadar dertlenen bir dijital pazarlama uzmanıyla çalışma fırsatı yakaladığımız için şanslıyız. Roasist ile teknik konuları dert etmeden dijital dünyada şirketinizi büyütmek için gönül rahatlığıyla çalışabilirsiniz.',
    name: 'Burak Özhan',
    role: 'Project Program Coordinator',
    tag: '360° Büyüme & Kreatif',
  },
  {
    quote:
      'Roasist ile yaklaşık iki senedir çalışıyoruz. Her sorumuza dürüstlükle yanıt alıyor, tüm sorunlarımızı efektif bir şekilde çözüyorlar. Yaptığımız iş gereği öncesi - sonrası değerlendirmesi yapmam gerekirse kazanç konusunda bize çok katkıları oldu. Nezaketli, dürüst ve profesyonel yaklaşımları için çok teşekkür ederim.',
    name: 'Gaye Tukar',
    role: 'Entrepreneur',
    tag: 'Performans & ROAS Yönetimi',
  },
  {
    quote:
      'Mesai kavramı olmaksızın sizin için çalışıyorlar. İşinde profesyonel, şeffaf ve sonuç odaklı bir dijital pazarlama ajansı arıyorsanız kesinlikle tavsiye ederim.',
    name: 'Celal Kandemir',
    role: 'Owner',
    tag: 'Performans Pazarlaması',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- CINEMATIC HERO SECTION -->
  <section class="relative overflow-hidden bg-slate-950 text-white pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-slate-800">
    <!-- Subtle Ambient Illumination -->
    <div
      class="pointer-events-none absolute -top-40 left-1/4 w-[38rem] h-[38rem] rounded-full bg-indigo-600/15 blur-[130px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute bottom-0 right-10 w-[30rem] h-[30rem] rounded-full bg-emerald-500/10 blur-[120px]"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        <!-- Left Column: High-Impact Positioning -->
        <div class="lg:col-span-6">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs font-medium text-slate-300 mb-6 backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Roasist Growth & Marketing Intelligence</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight text-white leading-[1.08] mb-6">
            Büyüyen İşletmeler İçin Dijital Pazarlama Çözümleri
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-8 max-w-xl">
            Kapsamlı ve özelleştirilmiş dijital pazarlama hizmetlerimizle işinizi bir sonraki seviyeye taşımanıza yardımcı olalım. Kendi geliştirdiğimiz <strong class="text-white">Roasist Marketing Intelligence OS</strong> veri altyapısıyla reklam bütçenizi ölçülebilir gelire dönüştürüyoruz.
          </p>

          <div class="flex flex-wrap items-center gap-4 mb-12">
            <a
              href="/iletisim/#analiz-formu"
              id="home-hero-primary-cta"
              class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl bg-white hover:bg-slate-100 text-slate-950 font-bold text-sm transition shadow-lg shadow-white/5"
            >
              <span>Ücretsiz Strateji Görüşmesi Planla</span>
              <Icon name="tabler:arrow-right" class="w-4 h-4" />
            </a>
            <a
              href="https://wa.me/+905415075350"
              target="_blank"
              rel="noopener noreferrer"
              id="home-hero-whatsapp-cta"
              class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-white border border-slate-700/80 font-semibold text-sm transition"
            >
              <Icon name="tabler:brand-whatsapp" class="w-4 h-4 text-emerald-400" />
              <span>Hızlı WhatsApp Hattı</span>
            </a>
          </div>

          <!-- Precision Telemetry Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-slate-800/90">
            <div>
              <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">360°</div>
              <div class="text-xs text-slate-400 mt-1">Bütünsel Büyüme Mimarisi</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 tracking-tight">29+</div>
              <div class="text-xs text-slate-400 mt-1">Ulusal & Global Referans</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">6 Kanal</div>
              <div class="text-xs text-slate-400 mt-1">Performans Reklam Ağı</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-extrabold text-indigo-400 tracking-tight">%100</div>
              <div class="text-xs text-slate-400 mt-1">Şeffaf Veri & Hesap</div>
            </div>
          </div>
        </div>

        <!-- Right Column: 3D Optical Glass Showcase + Interactive Simulator -->
        <div class="lg:col-span-6">
          <div class="relative rounded-3xl bg-slate-900/90 border border-slate-800 p-4 sm:p-6 shadow-2xl">
            <!-- Top Visual Showcase with 3D Prism Art & Floating Live Telemetry -->
            <div class="relative rounded-2xl overflow-hidden border border-slate-800/80 mb-5 bg-slate-950">
              <img
                src="/images/hero-prism.webp"
                alt="Roasist Veri Odaklı Büyüme ve Performans Analitiği"
                width="960"
                height="540"
                loading="eager"
                fetchpriority="high"
                class="w-full h-56 sm:h-64 object-cover opacity-90"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/35 to-transparent"></div>

              <!-- Floating Live Telemetry Cards over the 3D Art -->
              <div class="absolute top-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2">
                <span class="px-3 py-1 rounded-lg bg-slate-950/85 border border-white/10 backdrop-blur-md text-xs font-mono text-emerald-400 flex items-center gap-1.5">
                  <Icon name="tabler:trending-up" class="w-3.5 h-3.5" />
                  ROAS Odaklı Optimizasyon Aktif
                </span>
                <span class="px-3 py-1 rounded-lg bg-slate-950/85 border border-white/10 backdrop-blur-md text-xs font-mono text-slate-300">
                  GA4 · GTM · Meta CAPI · Google Ads API
                </span>
              </div>

              <div class="absolute bottom-3 left-3 right-3 grid grid-cols-3 gap-2.5">
                <div class="p-2.5 rounded-xl bg-slate-950/85 border border-white/10 backdrop-blur-md">
                  <div class="text-xs text-slate-400">Arama & PMax</div>
                  <div class="text-sm sm:text-base font-extrabold text-white mt-0.5">Yüksek Niyet</div>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-950/85 border border-white/10 backdrop-blur-md">
                  <div class="text-xs text-slate-400">SEO + AEO</div>
                  <div class="text-sm sm:text-base font-extrabold text-emerald-400 mt-0.5">Organik Otorite</div>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-950/85 border border-white/10 backdrop-blur-md">
                  <div class="text-xs text-slate-400">Kreatif & UX</div>
                  <div class="text-sm sm:text-base font-extrabold text-indigo-300 mt-0.5">Maksimum CR</div>
                </div>
              </div>
            </div>

            <!-- Interactive Sector & Channel Simulator -->
            <div class="rounded-2xl bg-slate-950/90 border border-slate-800/90 p-4 sm:p-5">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <div>
                  <div class="text-xs font-bold uppercase tracking-wider text-indigo-400">
                    İnteraktif Büyüme Simülatörü
                  </div>
                  <div class="text-sm font-bold text-white">Sektörünüze Göre Önerilen Kanal Dağılımı</div>
                </div>
                <div class="flex gap-1.5" role="tablist">
                  <button
                    type="button"
                    data-sim-sector="ecom"
                    class="sim-sector-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-600 text-white cursor-pointer transition"
                  >
                    E-Ticaret
                  </button>
                  <button
                    type="button"
                    data-sim-sector="health"
                    class="sim-sector-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 cursor-pointer transition"
                  >
                    Sağlık & İhracat
                  </button>
                  <button
                    type="button"
                    data-sim-sector="b2b"
                    class="sim-sector-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 cursor-pointer transition"
                  >
                    B2B & Kurumsal
                  </button>
                </div>
              </div>

              <!-- Animated Channel Bars -->
              <div id="sim-bars-container" class="space-y-3 mt-4">
                <div>
                  <div class="flex justify-between text-xs mb-1">
                    <span class="font-medium text-slate-200" id="sim-label-1">Google Shopping, Arama & PMax</span>
                    <span class="font-mono font-bold text-indigo-400" id="sim-val-1">%45 Pay</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
                    <div id="sim-bar-1" class="h-full bg-indigo-500 rounded-full transition-all duration-500" style="width: 45%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-xs mb-1">
                    <span class="font-medium text-slate-200" id="sim-label-2">Instagram, Facebook & Dinamik Katalog (CAPI)</span>
                    <span class="font-mono font-bold text-emerald-400" id="sim-val-2">%35 Pay</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
                    <div id="sim-bar-2" class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: 35%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-xs mb-1">
                    <span class="font-medium text-slate-200" id="sim-label-3">Teknik SEO, Kategori İçeriği & TikTok Kreatif</span>
                    <span class="font-mono font-bold text-sky-400" id="sim-val-3">%20 Pay</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
                    <div id="sim-bar-3" class="h-full bg-sky-400 rounded-full transition-all duration-500" style="width: 20%"></div>
                  </div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span id="sim-kpi-note" class="text-slate-400">Odak: Sepet Ortalaması (AOV), ROAS ve Sepet Terk Dönüşümü</span>
                <a href="/iletisim/#analiz-formu" class="font-bold text-white hover:text-indigo-300 shrink-0 ml-2">
                  Bütçemi Planla →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INFINITE CLIENT LOGO MARQUEE (29 REAL BRANDS) -->
  <section class="py-10 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800/80 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Büyüme Yolculuğuna Eşlik Ettiğimiz 29+ Ulusal ve Küresel Marka
      </div>
      <a href="/referanslar/" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
        Tüm Referansları ve Başarı Hikayelerini İncele →
      </a>
    </div>

    <div class="relative flex overflow-x-hidden group">
      <div class="flex animate-marquee gap-5 whitespace-nowrap py-2">
        {
          [...clients, ...clients].map((client) => (
            <div class="w-40 h-16 shrink-0 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 px-4 py-2.5 flex items-center justify-center hover:border-indigo-500 transition">
              <img
                src={client.logo}
                alt={client.alt}
                loading="lazy"
                width="130"
                height="48"
                class="max-h-10 w-auto object-contain opacity-85 hover:opacity-100 transition"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- BENTO ARCHITECTURE: 5 CORE SERVICES + ROASIST INTELLIGENCE OS -->
  <section id="hizmetler" class="py-20 md:py-28 bg-slate-50 dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-14 gap-6">
        <div class="max-w-2xl">
          <div class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 mb-2">
            360° Büyüme Ekosistemi
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
            Sadece Reklam Değil, Ölçülebilir Ticari Sonuç Üretiyoruz
          </h2>
        </div>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-md">
          Web sitenizin teknik altyapısından arama motoru otoritesine, performans kampanyalarından kreatif tasarıma kadar her adımı veriye dayalı yönetiyoruz.
        </p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-16">
        <!-- Bento 1: Performans Pazarlaması (Large 7-col) -->
        <a
          href="/hizmetler/performans-pazarlamasi/"
          class="lg:col-span-7 group rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-7 sm:p-9 hover:border-indigo-600 dark:hover:border-indigo-500 transition flex flex-col justify-between shadow-xs"
        >
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="px-3 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 text-xs font-bold">
                Performans Pazarlaması · PPC & ROAS
              </span>
              <span class="text-xs font-bold text-slate-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
                KEŞFET →
              </span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-3 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
              Performans Pazarlaması Yönetimi
            </h3>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Performans Pazarlaması, reklam verenlerin yalnızca gerçek sonuçlar için yatırım yaptığı veri odaklı büyüme disiplinidir. Google, Instagram, Facebook, TikTok, LinkedIn ve Yandex kanallarında bütçenizi maksimum yatırım getirisi (ROAS) ile ölçeklendiriyoruz.
            </p>
          </div>

          <!-- Visual Telemetry Mini-Dashboard inside Bento Card -->
          <div class="rounded-2xl bg-slate-950 text-white p-5 border border-slate-800">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span>Çok Kanallı Dönüşüm Mimarisi</span>
              <span class="text-emerald-400 font-mono font-bold">● Canlı Optimizasyon</span>
            </div>
            <div class="grid grid-cols-3 gap-3">
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
                <div class="text-xs text-slate-400">Hedefleme</div>
                <div class="text-sm font-bold text-white mt-0.5">Arama + Sosyal</div>
              </div>
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
                <div class="text-xs text-slate-400">Sinyal Kalitesi</div>
                <div class="text-sm font-bold text-emerald-400 mt-0.5">GTM + CAPI</div>
              </div>
