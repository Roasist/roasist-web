    const goalBtns = document.querySelectorAll('.ro-goal-btn');
    const planBadge = document.getElementById('plan-badge');
    const planTitle = document.getElementById('plan-title');
    const planDesc = document.getElementById('plan-desc');
    const planChannels = document.getElementById('plan-channels');
    const planKpis = document.getElementById('plan-kpis');

    goalBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-goal');
        const plan = goalPlans[key];
        if (!plan) return;
        goalBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        if (planBadge) planBadge.textContent = plan.badge;
        if (planTitle) planTitle.textContent = plan.title;
        if (planDesc) planDesc.textContent = plan.desc;
        if (planChannels) {
          planChannels.innerHTML = plan.channels
            .map(([label, href]) => `<a href="${href}" class="ro-plan-chip">${label}</a>`)
            .join('');
        }
        if (planKpis) {
          planKpis.innerHTML = `
            <div><span>Birincil Odak</span><strong>${plan.kpi1}</strong></div>
            <div><span>Ölçümleme Altyapısı</span><strong>${plan.kpi2}</strong></div>
          `;
