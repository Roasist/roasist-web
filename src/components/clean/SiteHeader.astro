---
const performanceServices = [
  { title: 'Performans Pazarlaması (Genel)', href: '/hizmetler/performans-pazarlamasi/', desc: 'Çok kanallı ROAS ve dönüşüm mimarisi' },
  { title: 'Google Reklamları (Google Ads)', href: '/hizmetler/performans-pazarlamasi/google-reklamlari/', desc: 'Arama, PMax, Alışveriş ve YouTube' },
  { title: 'Facebook Reklamları (Meta Ads)', href: '/hizmetler/performans-pazarlamasi/facebook-reklamlari/', desc: 'CAPI destekli katalog ve dönüşüm' },
  { title: 'Instagram Reklamları', href: '/hizmetler/performans-pazarlamasi/instagram-reklamlari/', desc: 'Reels, Story ve görsel satış hunileri' },
  { title: 'TikTok Reklamları', href: '/hizmetler/performans-pazarlamasi/tiktok-reklamlari/', desc: 'Kısa video ve Spark Ads büyümesi' },
  { title: 'LinkedIn Reklamları', href: '/hizmetler/performans-pazarlamasi/linkedin-reklamlari/', desc: 'B2B karar verici ve kurumsal lead' },
  { title: 'Yandex Reklamları', href: '/hizmetler/performans-pazarlamasi/yandex-reklamlari/', desc: 'Uluslararası pazar ve Yandex Direct' },
];

const growthServices = [
  { title: 'SEO & Yapay Zeka Aramaları (AEO)', href: '/hizmetler/seo/', desc: 'Teknik SEO, içerik otoritesi ve organik büyüme' },
  { title: '360° Dijital Pazarlama Yönetimi', href: '/hizmetler/360-derece-dijital-pazarlama-yonetimi/', desc: 'Tüm dijital kanalların tek merkezden yönetimi' },
  { title: 'Web Tasarım & Dönüşüm Mimarisi', href: '/hizmetler/web-tasarim/', desc: 'Hızlı, mobil ve SEO uyumlu kurumsal web siteleri' },
  { title: 'Grafik Tasarım & Reklam Kreatifi', href: '/hizmetler/grafik-tasarim/', desc: 'Performans odaklı reklam görselleri ve kimlik' },
];
---

<header class="kota-header" id="ro-site-header">
  <div class="kota-header-inner">
    <a href="/" class="kota-logo" aria-label="Roasist Anasayfa">
      <span class="kota-logo-word">ROASIST</span>
      <span class="kota-logo-dot" aria-hidden="true"></span>
    </a>

    <!-- KOTA Floating Center-Right Pill Nav -->
    <div class="kota-nav-shell">
      <nav class="kota-nav" aria-label="Ana Menü">
        <a href="/#calismalar" class="kota-nav-link">Çalışmalar</a>
        <a href="/hakkimizda/" class="kota-nav-link">Ajans</a>

        <div class="kota-nav-dropdown">
          <button type="button" class="kota-nav-link kota-dropdown-trigger" aria-expanded="false">
            <span>Hizmetler</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="kota-mega-menu" role="region" aria-label="Hizmetler Alt Menüsü">
            <div class="kota-mega-grid">
              <div class="kota-mega-col">
                <div class="kota-mega-heading">Performans Pazarlaması (7 Kanal)</div>
                <ul class="kota-mega-list">
                  {performanceServices.map((item) => (
                    <li>
                      <a href={item.href} class="kota-mega-item">
                        <span class="kota-mega-title">{item.title}</span>
                        <span class="kota-mega-desc">{item.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="kota-mega-col">
                <div class="kota-mega-heading">SEO / AEO, 360° & Kreatif Stüdyo</div>
                <ul class="kota-mega-list">
                  {growthServices.map((item) => (
                    <li>
                      <a href={item.href} class="kota-mega-item">
                        <span class="kota-mega-title">{item.title}</span>
                        <span class="kota-mega-desc">{item.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="kota-mega-cta">
                  <div>
                    <strong>Markanızı büyütecek doğru mimariyi kuralım.</strong>
                    <p>Mevcut reklam, SEO ve dönüşüm yapınızı ücretsiz analiz edelim.</p>
                  </div>
                  <a href="/iletisim/" class="kota-pill-btn kota-pill-btn-violet kota-pill-btn-sm">
                    <span>Ücretsiz Analiz</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <a href="/#sonuclar" class="kota-nav-link">Sonuçlar</a>
        <a href="/referanslar/" class="kota-nav-link">Referanslar</a>
        <a href="/blog/" class="kota-nav-link">Blog</a>
      </nav>

      <a href="/iletisim/" class="kota-cta-pill">
        <span class="kota-cta-pill-text">Projeye Başla</span>
        <span class="kota-cta-pill-icon" aria-hidden="true">↗</span>
      </a>

      <button type="button" class="kota-burger" id="ro-mobile-toggle" aria-label="Menüyü Aç/Kapat" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Fullscreen Drawer -->
  <div class="kota-mobile-drawer" id="ro-mobile-drawer" hidden>
    <div class="kota-mobile-drawer-inner">
      <div class="kota-mobile-group">
        <div class="kota-mobile-eyebrow">Menü</div>
        <a href="/#calismalar" class="kota-mobile-biglink">Çalışmalar</a>
        <a href="/hakkimizda/" class="kota-mobile-biglink">Ajans Hakkında</a>
        <a href="/referanslar/" class="kota-mobile-biglink">Referanslar (29+)</a>
        <a href="/blog/" class="kota-mobile-biglink">Güncel Yazılar</a>
        <a href="/iletisim/" class="kota-mobile-biglink">İletişim</a>
      </div>

      <div class="kota-mobile-group">
        <div class="kota-mobile-eyebrow">Performans Pazarlaması Hizmetleri</div>
        <div class="kota-mobile-pills">
          {performanceServices.map((item) => (
            <a href={item.href} class="kota-mobile-service-pill">{item.title}</a>
          ))}
        </div>
      </div>

      <div class="kota-mobile-group">
        <div class="kota-mobile-eyebrow">SEO, 360° & Web Tasarım</div>
        <div class="kota-mobile-pills">
          {growthServices.map((item) => (
            <a href={item.href} class="kota-mobile-service-pill">{item.title}</a>
          ))}
        </div>
      </div>

      <div class="kota-mobile-footer">
        <a href="/iletisim/" class="kota-pill-btn kota-pill-btn-violet" style="width:100%; justify-content:center;">
          <span>Projeye Başla — Ücretsiz Büyüme Analizi</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- KOTA Signature Floating Human Badge (Bottom-Right) -->
<a href="/iletisim/" class="kota-human-badge" aria-label="İnsanlar tarafından üretildi. Biriyle konuşun">
  <span class="kota-human-pulse" aria-hidden="true"></span>
  <span class="kota-human-text">İnsanlar tarafından üretildi. <strong>Biriyle konuşun</strong></span>
  <span class="kota-human-arrow" aria-hidden="true">→</span>
</a>

<!-- KOTA Custom Magnetic Cursor Follower -->
<div class="kota-cursor-follower" id="kota-cursor" aria-hidden="true">
  <span id="kota-cursor-label">İncele ↗</span>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@600;700;800&display=swap');

  :root {
    --kota-bg: #F4F3EF;
    --kota-bg-alt: #EAE8E1;
    --kota-surface: #FFFFFF;
    --kota-dark: #0D0D10;
    --kota-dark-card: #15151B;
    --kota-ink: #0D0D10;
    --kota-ink-secondary: #3F3F46;
    --kota-ink-muted: #71717A;
    --kota-violet: #7602FF;
    --kota-violet-bright: #8F2BFF;
    --kota-violet-deep: #5200B8;
    --kota-violet-tint: #F3E8FF;
    --kota-magenta: #C800FF;
    --kota-border: rgba(13, 13, 16, 0.1);
    --kota-border-strong: rgba(13, 13, 16, 0.18);
    --kota-radius-xl: 36px;
    --kota-radius-lg: 24px;
    --kota-radius-pill: 999px;

    /* Backward compatibility aliases for subpages */
    --ro-bg-white: #F4F3EF;
    --ro-bg-sand: #EAE8E1;
    --ro-bg-soft: #E4E2DA;
    --ro-ink: #0D0D10;
    --ro-ink-secondary: #3F3F46;
    --ro-ink-muted: #71717A;
    --ro-cobalt: #7602FF;
    --ro-cobalt-hover: #5200B8;
    --ro-cobalt-tint: #F3E8FF;
    --ro-border: rgba(13, 13, 16, 0.1);
    --ro-border-strong: rgba(13, 13, 16, 0.18);
    --ro-shadow-sm: 0 4px 14px rgba(13, 13, 16, 0.04);
    --ro-shadow-md: 0 20px 50px -12px rgba(13, 13, 16, 0.08);
    --ro-shadow-lg: 0 32px 80px -16px rgba(13, 13, 16, 0.14);
    --ro-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --ro-font-display: 'Syne', 'Plus Jakarta Sans', sans-serif;
    --ro-font-serif: 'Instrument Serif', Georgia, serif;
  }

  html {
    background-color: var(--kota-bg) !important;
    color: var(--kota-ink) !important;
    font-family: var(--ro-font-sans);
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--kota-bg) !important;
    color: var(--kota-ink) !important;
    font-family: var(--ro-font-sans);
    margin: 0;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  #main-content {
    background-color: var(--kota-bg) !important;
    color: var(--kota-ink) !important;
  }

  /* KOTA Floating Top Header */
  .kota-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 120;
    padding: 20px 32px;
    pointer-events: none;
    transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-header.is-scrolled {
    padding: 12px 32px;
  }

  .kota-header-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .kota-logo {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(13, 13, 16, 0.08);
    padding: 12px 22px;
    border-radius: 999px;
    box-shadow: 0 8px 30px rgba(13, 13, 16, 0.05);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  .kota-logo:hover {
    transform: scale(1.03);
    border-color: var(--kota-violet);
  }

  .kota-logo-word {
    font-family: var(--ro-font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.04em;
    color: var(--kota-ink);
    line-height: 1;
  }

  .kota-logo-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--kota-violet);
    box-shadow: 0 0 12px var(--kota-violet);
  }

  .kota-nav-shell {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    border: 1px solid rgba(13, 13, 16, 0.09);
    padding: 7px 8px 7px 18px;
    border-radius: 999px;
    box-shadow: 0 12px 36px rgba(13, 13, 16, 0.06);
  }

  .kota-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .kota-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 9px 15px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--kota-ink);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--ro-font-sans);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-nav-link:hover {
    background: rgba(118, 2, 255, 0.08);
    color: var(--kota-violet);
  }

  .kota-nav-dropdown {
    position: relative;
  }

  .kota-mega-menu {
    position: absolute;
    top: calc(100% + 16px);
    right: -140px;
    width: 820px;
    background: #FFFFFF;
    border: 1px solid rgba(13, 13, 16, 0.12);
    border-radius: 28px;
    box-shadow: 0 36px 90px -16px rgba(13, 13, 16, 0.18);
    padding: 30px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.98);
    transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .kota-nav-dropdown:hover .kota-mega-menu,
  .kota-nav-dropdown:focus-within .kota-mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .kota-mega-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 28px;
  }

  .kota-mega-heading {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--kota-violet);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--kota-border);
  }

  .kota-mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .kota-mega-item {
    display: flex;
    flex-direction: column;
    padding: 9px 12px;
    border-radius: 14px;
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .kota-mega-item:hover {
    background: var(--kota-violet-tint);
    transform: translateX(4px);
  }

  .kota-mega-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--kota-ink);
  }

  .kota-mega-desc {
    font-size: 0.77rem;
    color: var(--kota-ink-muted);
    margin-top: 2px;
  }

  .kota-mega-cta {
    margin-top: 16px;
    padding: 18px;
    border-radius: 18px;
    background: var(--kota-dark);
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .kota-mega-cta strong {
    display: block;
    font-size: 0.9rem;
    color: #FFFFFF;
  }

  .kota-mega-cta p {
    margin: 4px 0 0;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.45;
  }

  .kota-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    border-radius: 999px;
    background: var(--kota-dark);
    color: #FFFFFF !important;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-cta-pill:hover {
    background: var(--kota-violet);
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(118, 2, 255, 0.38);
  }

  .kota-cta-pill-icon {
    display: inline-flex;
    transition: transform 0.25s ease;
  }

  .kota-cta-pill:hover .kota-cta-pill-icon {
    transform: translate(2px, -2px);
  }

  /* Reusable KOTA Pill Buttons */
  .kota-pill-btn,
  .ro-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    border: 1.5px solid transparent;
    font-family: var(--ro-font-sans);
  }

  .kota-pill-btn-violet,
  .ro-btn-primary {
    background: var(--kota-violet);
    color: #FFFFFF !important;
    box-shadow: 0 10px 30px -6px rgba(118, 2, 255, 0.45);
  }

  .kota-pill-btn-violet:hover,
  .ro-btn-primary:hover {
    background: var(--kota-dark);
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -6px rgba(13, 13, 16, 0.32);
  }

  .kota-pill-btn-dark {
    background: var(--kota-dark);
    color: #FFFFFF !important;
  }

  .kota-pill-btn-dark:hover {
    background: var(--kota-violet);
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(118, 2, 255, 0.36);
  }

  .kota-pill-btn-outline,
  .ro-btn-secondary {
    background: transparent;
    color: var(--kota-ink) !important;
    border-color: var(--kota-border-strong);
  }

  .kota-pill-btn-outline:hover,
  .ro-btn-secondary:hover {
    background: var(--kota-dark);
    color: #FFFFFF !important;
    border-color: var(--kota-dark);
    transform: translateY(-2px);
  }

  .kota-pill-btn-sm {
    padding: 9px 18px;
    font-size: 0.82rem;
    align-self: flex-start;
  }

  /* KOTA Burger */
  .kota-burger {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--kota-border-strong);
    background: var(--kota-dark);
    color: #FFFFFF;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }

  .kota-burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: #FFFFFF;
    transition: transform 0.25s ease;
  }

  /* Mobile Drawer */
  .kota-mobile-drawer {
    pointer-events: auto;
    margin-top: 12px;
    background: #0D0D10;
    color: #FFFFFF;
    border-radius: 28px;
    padding: 28px 24px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  }

  .kota-mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .kota-mobile-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #A78BFA;
    margin-bottom: 10px;
  }

  .kota-mobile-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .kota-mobile-biglink {
    font-family: var(--ro-font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: #FFFFFF;
    text-decoration: none;
    padding: 4px 0;
  }

  .kota-mobile-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kota-mobile-service-pill {
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* KOTA Floating Human Badge */
  .kota-human-badge {
    position: fixed;
    bottom: 24px;
    right: 28px;
    z-index: 110;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    background: rgba(13, 13, 16, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
    font-size: 0.83rem;
    text-decoration: none;
    box-shadow: 0 16px 40px rgba(13, 13, 16, 0.25);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-human-badge:hover {
    background: var(--kota-violet);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 20px 44px rgba(118, 2, 255, 0.45);
  }

  .kota-human-pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #A855F7;
    box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.7);
    animation: kotaPulse 2s infinite;
  }

  @keyframes kotaPulse {
    0% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.7); }
    70% { box-shadow: 0 0 0 9px rgba(168, 85, 247, 0); }
    100% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); }
  }

  /* Custom Magnetic Cursor Follower */
  .kota-cursor-follower {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    pointer-events: none;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--kota-violet);
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 12px 30px rgba(118, 2, 255, 0.45);
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.6);
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .kota-cursor-follower.is-active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  @media (max-width: 1024px) {
    .kota-header {
      padding: 14px 16px;
    }
    .kota-nav {
      display: none;
    }
    .kota-nav-shell {
      padding: 6px;
    }
    .kota-burger {
      display: inline-flex;
    }
    .kota-human-badge {
      bottom: 16px;
      right: 16px;
      padding: 10px 16px;
      font-size: 0.78rem;
    }
    .kota-cursor-follower {
      display: none !important;
    }
  }

  @media (max-width: 560px) {
    .kota-cta-pill {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('ro-site-header');
    const toggle = document.getElementById('ro-mobile-toggle');
    const drawer = document.getElementById('ro-mobile-drawer');
    const cursor = document.getElementById('kota-cursor');
    const cursorLabel = document.getElementById('kota-cursor-label');

    window.addEventListener('scroll', () => {
      if (!header) return;
      if (window.scrollY > 40) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }, { passive: true });

    if (toggle && drawer) {
      toggle.addEventListener('click', () => {
        const isHidden = drawer.hasAttribute('hidden');
        if (isHidden) {
          drawer.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          drawer.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });

      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          drawer.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    if (cursor && window.matchMedia('(pointer: fine)').matches) {
      window.addEventListener('mousemove', (e) => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
      }, { passive: true });

      document.querySelectorAll('[data-cursor]').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          const text = el.getAttribute('data-cursor') || 'İncele ↗';
          if (cursorLabel) cursorLabel.textContent = text;
          cursor.classList.add('is-active');
        });
        el.addEventListener('mouseleave', () => {
          cursor.classList.remove('is-active');
        });
      });
    }
  });
</script>
