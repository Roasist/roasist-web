---
const currentYear = new Date().getFullYear();

const sectors = [
  'E-Ticaret & D2C Markalar',
  'B2B Teknoloji & SaaS',
  'Sağlık & Medikal Turizm',
  'Kurumsal & Finans',
  'Gayrimenkul & İnşaat',
  'Eğitim & Akademi',
  'İhracat & Global Pazarlar',
];
---

<footer class="kota-footer">
  <div class="kota-footer-shell">
    <!-- Top Giant KOTA Contact Hero -->
    <div class="kota-footer-hero">
      <div class="kota-footer-hero-left">
        <span class="kota-footer-eyebrow">BİR SONRAKİ BÜYÜME ADIMINIZ</span>
        <h2 class="kota-footer-headline">
          Markanızı dijitalde <em>durdurulamaz</em> kılmaya hazır mısınız?
        </h2>
        <div class="kota-footer-email-row">
          <a href="mailto:info@roasist.com" class="kota-footer-email-big">info@roasist.com</a>
          <button type="button" class="kota-copy-email-btn" id="kota-copy-email" data-email="info@roasist.com">
            <span class="kota-copy-icon" aria-hidden="true">⧉</span>
            <span id="kota-copy-text">E-posta adresini kopyala</span>
          </button>
        </div>
      </div>

      <div class="kota-footer-hero-right">
        <div class="kota-footer-cta-card">
          <span class="kota-card-badge">Ücretsiz Ön Analiz</span>
          <h3>Reklam ve SEO potansiyelinizi 30 dakikada birlikte inceleyelim.</h3>
          <p>Hesaplarınızdaki bütçe kaçaklarını ve büyüme fırsatlarını şeffaf bir yol haritasıyla sunuyoruz.</p>
          <a href="/iletisim/" class="kota-pill-btn kota-pill-btn-violet">
            <span>Projeye Başla</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- KOTA "Our Sectors" Pill Strip -->
    <div class="kota-footer-sectors">
      <span class="kota-sectors-label">Uzmanlaştığımız Sektörler:</span>
      <div class="kota-sectors-list">
        {sectors.map((sec) => (
          <a href="/referanslar/" class="kota-sector-pill">{sec}</a>
        ))}
      </div>
    </div>

    <!-- Main 4-Column SEO Architecture -->
    <div class="kota-footer-grid">
      <div class="kota-footer-col-brand">
        <a href="/" class="kota-footer-logo">
          <span>ROASIST</span>
          <span class="kota-footer-logo-dot"></span>
        </a>
        <p class="kota-footer-about">
          Veri berraklığı, yüksek dönüşümlü kreatif mühendislik ve ölçeklenebilir ROAS mimarisiyle markaları büyüten yeni nesil dijital performans ajansı.
        </p>
        <div class="kota-footer-badges">
          <span class="kota-partner-badge">Google Ads Uzmanlığı</span>
          <span class="kota-partner-badge">Meta CAPI & Performans</span>
          <span class="kota-partner-badge">Teknik SEO & AEO</span>
        </div>
      </div>

      <div class="kota-footer-col">
        <h3>Performans Pazarlaması</h3>
        <ul>
          <li><a href="/hizmetler/performans-pazarlamasi/">Performans Pazarlaması</a></li>
          <li><a href="/hizmetler/performans-pazarlamasi/google-reklamlari/">Google Reklamları (Ads)</a></li>
          <li><a href="/hizmetler/performans-pazarlamasi/facebook-reklamlari/">Facebook Reklamları (Meta)</a></li>
          <li><a href="/hizmetler/performans-pazarlamasi/instagram-reklamlari/">Instagram Reklamları</a></li>
          <li><a href="/hizmetler/performans-pazarlamasi/tiktok-reklamlari/">TikTok Reklamları</a></li>
          <li><a href="/hizmetler/performans-pazarlamasi/linkedin-reklamlari/">LinkedIn B2B Reklamları</a></li>
          <li><a href="/hizmetler/performans-pazarlamasi/yandex-reklamlari/">Yandex Reklamları</a></li>
        </ul>
      </div>

      <div class="kota-footer-col">
        <h3>Büyüme, SEO & Stüdyo</h3>
        <ul>
          <li><a href="/hizmetler/seo/">SEO & Yapay Zeka Aramaları (AEO)</a></li>
          <li><a href="/hizmetler/360-derece-dijital-pazarlama-yonetimi/">360° Dijital Pazarlama Yönetimi</a></li>
          <li><a href="/hizmetler/web-tasarim/">Web Tasarım & Dönüşüm Mimarisi</a></li>
          <li><a href="/hizmetler/grafik-tasarim/">Grafik Tasarım & Reklam Kreatifi</a></li>
        </ul>
      </div>

      <div class="kota-footer-col">
        <h3>Ajans & Keşfet</h3>
        <ul>
          <li><a href="/hakkimizda/">Hakkımızda</a></li>
          <li><a href="/referanslar/">Referanslarımız (29+ Marka)</a></li>
          <li><a href="/blog/">Güncel Yazılar (Blog)</a></li>
          <li><a href="/iletisim/">İletişim & Strateji Görüşmesi</a></li>
          <li><a href="/gizlilik-politikasi-ve-kullanim-sartlari/">Gizlilik Politikası ve Kullanım Şartları</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal & Giant Watermark -->
    <div class="kota-footer-bottom">
      <p>© {currentYear} Roasist Dijital Pazarlama ve Büyüme Ajansı. Tüm hakları saklıdır. İstanbul, Türkiye.</p>
      <div class="kota-footer-bottom-links">
        <a href="/gizlilik-politikasi-ve-kullanim-sartlari/">Gizlilik & KVKK</a>
        <a href="/sitemap-index.xml">Site Haritası (XML)</a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .kota-footer {
    background: #0D0D10;
    color: #FFFFFF;
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    padding: 96px 0 56px;
    margin-top: 80px;
    position: relative;
    overflow: hidden;
  }

  .kota-footer::before {
    content: '';
    position: absolute;
    top: -180px;
    right: -120px;
    width: 560px;
    height: 560px;
    background: radial-gradient(circle, rgba(118, 2, 255, 0.28) 0%, rgba(118, 2, 255, 0) 70%);
    pointer-events: none;
  }

  .kota-footer-shell {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 32px;
    position: relative;
    z-index: 1;
  }

  .kota-footer-hero {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 48px;
    align-items: center;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .kota-footer-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #A855F7;
    margin-bottom: 18px;
  }

  .kota-footer-headline {
    margin: 0 0 28px;
    font-family: var(--ro-font-display);
    font-size: clamp(2.2rem, 4.4vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: #FFFFFF;
  }

  .kota-footer-headline em {
    font-family: var(--ro-font-serif);
    font-weight: 400;
    font-style: italic;
    color: #C084FC;
  }

  .kota-footer-email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }

  .kota-footer-email-big {
    font-family: var(--ro-font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    font-weight: 800;
    color: #FFFFFF;
    text-decoration: none;
    letter-spacing: -0.03em;
    border-bottom: 2px solid var(--kota-violet);
    padding-bottom: 4px;
    transition: color 0.2s ease;
  }

  .kota-footer-email-big:hover {
    color: #C084FC;
  }

  .kota-copy-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--ro-font-sans);
    transition: all 0.22s ease;
  }

  .kota-copy-email-btn:hover {
    background: var(--kota-violet);
    border-color: var(--kota-violet);
    transform: translateY(-2px);
  }

  .kota-footer-cta-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 32px;
    padding: 36px;
    backdrop-filter: blur(12px);
  }

  .kota-card-badge {
    display: inline-block;
    padding: 5px 13px;
    border-radius: 999px;
    background: rgba(118, 2, 255, 0.25);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #E9D5FF;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  .kota-footer-cta-card h3 {
    margin: 0 0 10px;
    font-family: var(--ro-font-display);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.25;
    color: #FFFFFF;
  }

  .kota-footer-cta-card p {
    margin: 0 0 22px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Sectors Strip */
  .kota-footer-sectors {
    padding: 32px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .kota-sectors-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.55);
    margin-right: 6px;
  }

  .kota-sectors-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .kota-sector-pill {
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .kota-sector-pill:hover {
    background: var(--kota-violet);
    border-color: var(--kota-violet);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  /* Main Footer Grid */
  .kota-footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 0.95fr;
    gap: 44px;
    padding: 56px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .kota-footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--ro-font-display);
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    text-decoration: none;
  }

  .kota-footer-logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--kota-violet);
    box-shadow: 0 0 14px var(--kota-violet);
  }

  .kota-footer-about {
    margin: 16px 0 22px;
    font-size: 0.92rem;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.68);
    max-width: 340px;
  }

  .kota-footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kota-partner-badge {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(118, 2, 255, 0.16);
    border: 1px solid rgba(168, 85, 247, 0.3);
    font-size: 0.75rem;
    font-weight: 600;
    color: #E9D5FF;
  }

  .kota-footer-col h3 {
    margin: 0 0 18px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #A855F7;
  }

  .kota-footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .kota-footer-col a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.18s ease, transform 0.18s ease;
    display: inline-block;
  }

  .kota-footer-col a:hover {
    color: #FFFFFF;
    transform: translateX(4px);
  }

  .kota-footer-bottom {
    padding-top: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.52);
  }

  .kota-footer-bottom p {
    margin: 0;
  }

  .kota-footer-bottom-links {
    display: flex;
    gap: 24px;
  }

  .kota-footer-bottom-links a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }

  .kota-footer-bottom-links a:hover {
    color: #FFFFFF;
  }

  @media (max-width: 980px) {
    .kota-footer-hero {
      grid-template-columns: 1fr;
    }
    .kota-footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .kota-footer {
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
      padding: 64px 0 40px;
    }
    .kota-footer-shell {
      padding: 0 20px;
    }
    .kota-footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('kota-copy-email');
    const copyText = document.getElementById('kota-copy-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || 'info@roasist.com';
        try {
          await navigator.clipboard.writeText(email);
          copyText.textContent = 'Kopyalandı! (info@roasist.com) ✓';
          setTimeout(() => {
            copyText.textContent = 'E-posta adresini kopyala';
          }, 2600);
        } catch {
          window.location.href = 'mailto:' + email;
        }
      });
    }
  });
</script>
