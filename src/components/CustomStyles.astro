---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --aw-font-serif: var(--font-inter), Georgia, serif;
    --aw-font-heading: 'Outfit', var(--font-inter), sans-serif;

    --aw-color-primary: rgb(79 70 229);
    --aw-color-secondary: rgb(67 56 202);
    --aw-color-accent: rgb(37 99 235);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(30 41 59);
    --aw-color-text-muted: rgb(71 85 105);
    --aw-color-bg-page: rgb(248 250 252);

    --aw-color-bg-page-dark: rgb(9 11 16);

    ::selection {
      background-color: rgb(224 231 255);
      color: rgb(30 27 75);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --aw-font-serif: var(--font-inter), Georgia, serif;
    --aw-font-heading: 'Outfit', var(--font-inter), sans-serif;

    --aw-color-primary: rgb(99 102 241);
    --aw-color-secondary: rgb(79 70 229);
    --aw-color-accent: rgb(56 189 248);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(203 213 225);
    --aw-color-text-muted: rgb(148 163 184);
    --aw-color-bg-page: rgb(9 11 16);

    ::selection {
      background-color: rgb(49 46 129);
      color: rgb(248 250 252);
    }
  }
</style>
