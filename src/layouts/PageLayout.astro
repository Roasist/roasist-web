---
import Layout from '~/layouts/Layout.astro';
import SiteHeader from '~/components/clean/SiteHeader.astro';
import SiteFooter from '~/components/clean/SiteFooter.astro';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {Astro.slots.has('header') ? <slot name="header" /> : <SiteHeader />}
  <main class="flex-1 bg-white text-slate-900" id="main-content">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <SiteFooter />}
</Layout>
