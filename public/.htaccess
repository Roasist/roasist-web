# ==============================================================================
# Roasist Corporate Website — Veridyen (LiteSpeed / Apache) Hardened Config
# ==============================================================================
Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block hidden dotfiles/directories (except .well-known for AutoSSL) & sensitive extensions
  RewriteRule ^(?!\.well-known(?:/|$))(?:.+/)?\.[^/]+(?:/|$) - [F,L]
  RewriteRule \.(?:yml|yaml|jsonl|log|bak|sql|env|ini|sh|lock|md)$ - [F,L,NC]

  # 2. Force HTTPS + canonical www.roasist.com on production domain
  RewriteCond %{HTTP_HOST} ^(www\.)?roasist\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://www.roasist.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^roasist\.com$ [NC]
  RewriteRule ^ https://www.roasist.com%{REQUEST_URI} [R=301,L]

  # 3. Block & retire legacy WordPress system/attack endpoints cleanly (410 Gone)
  RewriteRule ^(wp-admin|wp-includes)(/.*)?$ - [G,L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php|wp-config\.php|readme\.html|license\.txt)$ - [G,L]

  # 4. Legacy WordPress & Renamed Route 301 SEO Redirects -> New Roasist Routes
  RewriteRule ^hizmetler/yapay-zeka-seo/?$ /hizmetler/aeo-geo/ [R=301,L]
  RewriteRule ^en/ai-search-aeo-geo/?$ /en/aeo-geo/ [R=301,L]
  RewriteRule ^service/yapay-zeka-seo/?$ /hizmetler/aeo-geo/ [R=301,L]
  RewriteRule ^service/(.+?)/?$ /hizmetler/$1/ [R=301,L]
  RewriteRule ^en/service/(.+?)/?$ /en/$1/ [R=301,L]
  RewriteRule ^hizmetlerimiz/?$ /hizmetler/ [R=301,L]
  RewriteRule ^hizmetlerimiz/(.*)$ /hizmetler/$1 [R=301,L]
  RewriteRule ^(hizmetler/)?arama-motoru-optimizasyonu(-seo)?/?$ /hizmetler/seo/ [R=301,L]
  RewriteRule ^360-derece-dijital-pazarlama-yonetimi/?$ /hizmetler/360-derece-dijital-pazarlama-yonetimi/ [R=301,L]
  RewriteRule ^performans-pazarlamasi/?$ /hizmetler/performans-pazarlamasi/ [R=301,L]
  RewriteRule ^web-tasarim/?$ /hizmetler/web-tasarim/ [R=301,L]
  RewriteRule ^grafik-tasarim/?$ /hizmetler/grafik-tasarim/ [R=301,L]
  RewriteRule ^(iletisim-2|bize-ulasin|randevu)/?$ /iletisim/ [R=301,L]
  RewriteRule ^(hakkimizda-2|biz-kimiz)/?$ /hakkimizda/ [R=301,L]
  RewriteRule ^(referanslarimiz|portfolyo)/?$ /referanslar/ [R=301,L]
  RewriteRule ^(gizlilik-politikasi|kullanim-sartlari|kvkk)/?$ /gizlilik-politikasi-ve-kullanim-sartlari/ [R=301,L]
  RewriteRule ^blog/(performans-pazarlamasinda-roas-optimizasyonu|kurumsal-seo-ve-yapay-zeka-aramalari-aeo-rehberi|360-dijital-pazarlama-kanallar-arasi-sinerji|Veriye-Dayali-Dijital-Pazarlama-Stratejisi-Nedir|Reklam-Harcamalarinin-Geri-Donusu-ROAS-Nasil-Hesaplanir)/?$ /blog/ [R=301,L]
  RewriteRule ^blog/etiket/.*$ /blog/ [R=301,L]
  RewriteRule ^blog/kategori/(dijital-pazarlama|reklam-yonetimi|seo-aeo|dijital-strateji)/?$ /blog/ [R=301,L]
  RewriteRule ^en/blog/(enterprise-seo-and-ai-search-aeo-guide|how-to-calculate-and-optimize-roas)/?$ /en/blog/ [R=301,L]
  RewriteRule ^(blog/hello-world|feed|comments/feed)/?$ /blog/ [R=301,L]
  RewriteRule ^wp-sitemap\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]

  # 5. Enforce trailing slash on clean directory routes (skip /api/ and files)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# 6. Custom Bilingual 404 Page
ErrorDocument 404 /404.html

# 7. Hardened Browser Security Headers (compatible with GTM & same-origin 3D iframes)
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# 8. Browser & LiteSpeed Static Asset Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
